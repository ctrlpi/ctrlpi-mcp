{
  "name": "ctrlpi-mcp",
  "version": "0.9.41",
  "mcpName": "io.github.ctrlpi/ctrlpi-mcp",
  "description": "An MCP (Model Context Protocol) server that lets an AI agent (e.g. Claude Desktop) control one or more GPIO agents (pi-gpio-api on a Raspberry Pi, pico-gpio-api on a Pico W or Pico 2 W, esp32-gpio-api on an ESP32) by calling their REST API over HTTP.",
  "main": "server.js",
  "files": [
    "server.js"
  ],
  "bin": {
    "ctrlpi-mcp": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "run": "node server.js",
    "test": "node --test test/ctrlpi-mcp.test.js",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctrlpi/ctrlpi-mcp.git"
  },
  "keywords": [
    "mcp",
    "model context protocol",
    "gpio",
    "raspberry pi",
    "raspberry-pi-pico",
    "raspberry pico",
    "pico",
    "esp32",
    "claude",
